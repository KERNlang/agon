{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lifecycle": {
            "type": "string",
            "minLength": 1
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "normativeClause": {
            "type": "string",
            "minLength": 1
          },
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "enum": [
              "all",
              "darwin",
              "linux"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "specified",
              "tested",
              "measured",
              "blocked",
              "deferred",
              "not-applicable"
            ]
          }
        },
        "required": [
          "lifecycle",
          "artifact",
          "owner",
          "normativeClause",
          "evidenceId",
          "platform",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "cells"
  ],
  "additionalProperties": false,
  "$id": "https://kernlang.dev/schemas/agon/modular/v1/coverage-ledger.schema.json",
  "title": "Modular Agon v1 coverage-ledger"
}
