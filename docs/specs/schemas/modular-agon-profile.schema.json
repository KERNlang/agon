{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kernlang.dev/schemas/modular-agon-profile.schema.json",
  "title": "Modular Agon profile definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "revision", "selected", "disabled", "constraints", "settingsDefaults"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision": { "type": "integer", "minimum": 0 },
    "selected": { "$ref": "#/$defs/modIds" },
    "disabled": { "$ref": "#/$defs/modIds" },
    "constraints": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/modId" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "settingsDefaults": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/modId" },
      "additionalProperties": true
    }
  },
  "$defs": {
    "modId": { "type": "string", "maxLength": 256, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "modIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/modId" } }
  }
}
