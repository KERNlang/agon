{
  "name": "agon-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/mod-api",
    "packages/mod-kernel",
    "packages/core",
    "packages/forge",
    "packages/adapter-cli",
    "packages/cli",
    "packages/mcp",
    "packages/saas-api",
    "packages/dedup",
    "packages/support-engine-runtime",
    "packages/support-persistence",
    "packages/support-dedup",
    "packages/support-browser-bridge",
    "packages/support-saas-api",
    "packages/support-engine-catalog",
    "packages/support-verification",
    "packages/support-panel",
    "packages/support-worktree",
    "packages/support-agent-runtime",
    "packages/support-judge",
    "packages/mod-ask",
    "packages/mod-plan",
    "packages/mod-think",
    "packages/mod-brainstorm",
    "packages/mod-team-brainstorm",
    "packages/mod-tribunal",
    "packages/mod-team-tribunal",
    "packages/mod-campfire",
    "packages/mod-forge",
    "packages/mod-team-forge",
    "packages/mod-synthesis",
    "packages/mod-review",
    "packages/mod-pipeline-orchestration",
    "packages/mod-pipeline-delivery",
    "packages/mod-agent",
    "packages/mod-goal",
    "packages/mod-conquer",
    "packages/mod-nero",
    "packages/mod-council",
    "packages/mod-research",
    "packages/mod-rag",
    "packages/mod-mutate",
    "packages/mod-naturalize",
    "packages/mod-sanitize",
    "packages/mod-rooms",
    "packages/mod-jobs",
    "packages/mod-browser",
    "packages/mod-ratings",
    "packages/mod-history",
    "packages/mod-provenance",
    "packages/mod-flow",
    "packages/mod-memory",
    "packages/mod-worktrees",
    "packages/mod-skill-authoring",
    "packages/mod-git-actions",
    "packages/mod-routing-docs"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "guard:reexports": "node scripts/guard/reexport-surface.mjs",
    "docs:modes": "npm run build:cli && node scripts/generate-mode-docs.mjs",
    "rebuild": "npm run build",
    "build": "npm run build:cli && npm run build:types",
    "build:types": "tsc -b --force",
    "build:cli": "npm run build:cli:workspaces",
    "build:cli:workspaces": "npm run build -w packages/mod-api && npm run build -w packages/mod-kernel && npm run build -w packages/core && npm run build -w packages/forge && npm run build -w packages/adapter-cli && npm run build -w packages/cli",
    "install:cli": "npm run build:cli && cd packages/cli && npm link",
    "release:set-version": "node scripts/release/set-version.mjs",
    "release:dedup": "node scripts/release/publish-if-new.mjs packages/dedup",
    "release:cli": "npm run build:cli && node scripts/release/publish-if-new.mjs packages/cli",
    "release": "npm run release:dedup && npm run release:cli",
    "typecheck": "tsc -b",
    "test": "npm run test:ts",
    "test:ts": "node scripts/run-node22.mjs vitest run",
    "test:watch": "node scripts/run-node22.mjs vitest",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "lint:dead": "npm run knip",
    "spec:modular-projections": "node scripts/spec/generate-modular-agon-compat-projections.mjs",
    "spec:modular-projections:check": "node scripts/spec/generate-modular-agon-compat-projections.mjs --check",
    "spec:modular-package-graph": "node scripts/spec/generate-modular-agon-package-graph.mjs",
    "spec:modular-package-graph:check": "node scripts/spec/generate-modular-agon-package-graph.mjs --check",
    "spec:modular-generated:check": "node scripts/spec/verify-modular-generated-artifacts.mjs",
    "spec:modular-generated:self-test": "node scripts/spec/verify-modular-generated-artifacts.mjs --self-test",
    "spec:modular-qualification:self-test": "node scripts/spec/verify-modular-slice1a-gates.mjs",
    "pretest:modular-slice1a": "npm run spec:modular-generated:self-test && npm run spec:modular-qualification:self-test && npm run spec:modular-generated:check && npm run build -w packages/mod-api && npm run build -w packages/mod-kernel",
    "spec:modular-pack": "node scripts/spec/verify-modular-slice1a-pack.mjs",
    "test:modular-slice1a": "npm run spec:modular-projections:check && npm run spec:modular-package-graph:check && npm run spec:modular-pack && node scripts/run-node22.mjs vitest run tests/unit/modular-*.test.ts tests/spec/modular-agon-contracts.test.ts",
    "perf:modular-slice1a": "node --expose-gc scripts/spec/measure-modular-slice1a.mjs",
    "spec:modular-slice1b:self-test": "node scripts/spec/verify-modular-slice1b-gates.mjs",
    "spec:modular-slice1b:qualify:index": "node scripts/spec/qualify-modular-agon-clean-checkout.mjs --subject=index --run-clean",
    "spec:modular-slice1b:qualify:commit": "node scripts/spec/qualify-modular-agon-clean-checkout.mjs --subject=commit --run-clean",
    "test:modular-legacy-oracle": "node scripts/spec/verify-modular-legacy-oracle.mjs",
    "test:modular-oracle-boundary": "node scripts/spec/verify-modular-legacy-oracle-negative-controls.mjs",
    "test:modular-host": "node scripts/run-node22.mjs vitest run tests/unit/modular-host.test.ts tests/unit/modular-generation-leases.test.ts tests/unit/modular-host-boundaries.test.ts tests/unit/modular-writer-lock-safety.test.ts tests/unit/modular-lease-corruption.test.ts",
    "test:modular-crash-recovery": "node scripts/run-node22.mjs vitest run tests/unit/modular-crash-recovery.test.ts tests/unit/modular-rollback.test.ts tests/unit/modular-host-failures.test.ts tests/unit/modular-process-crash.test.ts tests/unit/modular-host-corruption.test.ts tests/unit/modular-receipt-reconciliation.test.ts",
    "test:modular-migration-engine": "node scripts/run-node22.mjs vitest run tests/unit/modular-migration-engine.test.ts",
    "test:modular-observability": "node scripts/run-node22.mjs vitest run tests/unit/modular-observability.test.ts tests/unit/modular-journal-schema.test.ts tests/unit/modular-host-receipts.test.ts tests/unit/modular-receipt-immutability.test.ts",
    "test:modular-slice2": "npm run test:modular-host && npm run test:modular-crash-recovery && npm run test:modular-migration-engine && npm run test:modular-observability",
    "perf:modular-slice2": "node --expose-gc scripts/spec/measure-modular-slice2.mjs",
    "spec:modular-slice2:qualify:index": "node scripts/spec/qualify-modular-agon-slice2.mjs --subject=index --run-clean",
    "spec:modular-slice2:qualify:commit": "node scripts/spec/qualify-modular-agon-slice2.mjs --subject=commit --run-clean",
    "test:modular-state": "node scripts/run-node22.mjs vitest run tests/unit/modular-state.test.ts tests/unit/modular-state-schema.test.ts tests/unit/modular-state-matrix.test.ts tests/unit/modular-activation-service.test.ts",
    "test:modular-ui": "node scripts/run-node22.mjs vitest run tests/unit/modular-ui.test.ts",
    "test:modular-ui-accessibility": "node scripts/run-node22.mjs vitest run tests/unit/modular-ui-accessibility.test.ts",
    "spec:modular-slice3:self-test": "node scripts/spec/verify-modular-slice3-gates.mjs",
    "test:modular-slice3": "npm run test:modular-state && npm run test:modular-ui && npm run test:modular-ui-accessibility && npm run spec:modular-slice3:self-test",
    "perf:modular-slice3": "node --expose-gc scripts/spec/measure-modular-slice3.mjs",
    "spec:modular-slice3:qualify:index": "node scripts/spec/qualify-modular-agon-slice3.mjs --subject=index --run-clean",
    "spec:modular-slice3:qualify:commit": "node scripts/spec/qualify-modular-agon-slice3.mjs --subject=commit --run-clean",
    "build:modular-support": "node scripts/spec/verify-modular-support-packages.mjs",
    "spec:modular-support-metadata:check": "node scripts/spec/generate-modular-support-package-metadata.mjs --check",
    "test:modular-support-rollback": "node scripts/spec/verify-modular-support-rollback.mjs && node scripts/spec/verify-modular-support-rollback.mjs --self-test",
    "test:modular-support-packages": "node scripts/spec/verify-modular-support-packages.mjs && node scripts/run-node22.mjs ./node_modules/.bin/vitest run tests/unit/modular-support-parity.test.ts tests/unit/modular-support-runtime-isolation.test.ts",
    "test:modular-boundaries": "node scripts/spec/verify-modular-support-boundaries.mjs --self-test && node scripts/spec/verify-modular-support-assets.mjs",
    "test:modular-api-compat": "node scripts/spec/verify-modular-support-api-compat.mjs",
    "test:modular-foundation-mutation": "node scripts/spec/verify-modular-foundation-mutation.mjs",
    "perf:modular-slice4": "node scripts/spec/measure-modular-slice4.mjs",
    "spec:modular-slice4:qualify:index": "node scripts/spec/qualify-modular-agon-slice4.mjs --subject=index --run-clean",
    "spec:modular-slice4:qualify:commit": "node scripts/spec/qualify-modular-agon-slice4.mjs --subject=commit --run-clean",
    "spec:modular-first-party:check": "node scripts/spec/generate-modular-first-party-packages.mjs --check && node scripts/spec/generate-modular-first-party-migration-ledger.mjs --check",
    "test:modular-first-party": "node scripts/spec/verify-modular-first-party-packages.mjs --self-test",
    "test:modular-disable-matrix": "node scripts/spec/verify-modular-disable-matrix.mjs --self-test",
    "test:representative-workflows": "npm run test:modular-legacy-oracle && npm run test:modular-oracle-boundary",
    "test:modular-package-data-migrations": "node scripts/spec/verify-modular-package-data-migrations.mjs --self-test",
    "test:modular-first-party-rollback": "node scripts/spec/verify-modular-first-party-rollback.mjs && node scripts/spec/verify-modular-first-party-rollback.mjs --self-test",
    "perf:modular-slice5": "node scripts/spec/measure-modular-slice5.mjs",
    "spec:modular-slice5:qualify:index": "node scripts/spec/qualify-modular-agon-slice5.mjs --subject=index --run-clean",
    "spec:modular-slice5:qualify:commit": "node scripts/spec/qualify-modular-agon-slice5.mjs --subject=commit --run-clean"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.22.0",
    "npm": "10.9.4"
  },
  "devDependencies": {
    "@kernlang/core": "~4.5.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "10.8.1",
    "knip": "^6.32.2",
    "patch-package": "^8.0.1",
    "tsup": "^8.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "overrides": {
    "brace-expansion@2.0.0 - 2.1.3": "2.1.4",
    "brace-expansion@3.0.0 - 5.0.8": "5.0.9",
    "esbuild": "0.28.2",
    "nanoid@<=3.3.17": "3.3.18",
    "postcss@<=8.5.22": "8.5.26",
    "vite@7.0.0 - 7.3.3": "7.3.6"
  },
  "optionalDependencies": {
    "@kernlang/cli": "~4.5.0"
  }
}
