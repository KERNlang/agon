    "ai",
    "cli",
    "llm",
    "orchestration",
    "multi-agent",
    "agent",
    "claude",
    "codex",
    "gemini",
    "code-generation",
    "forge",
    "tribunal",
    "synthesis",
    "council",
    "conquer",
    "agon",
    "kernlang"
  ],
  "homepage": "https://github.com/KERNlang/agon#readme",
