// ── `agon review --mutate` — advisory mutation findings ─────────────────
//
// A normal review asks "is this code wrong?". Mutation asks the complementary
// question the panel cannot: "would your tests NOTICE if it were?". This block
// is the ADVISORY bolt-on: it runs the same budgeted mutant pipeline as
// `agon mutate` over the diff the review already resolved, writes its artifacts
// into a `mutation/` SUBDIRECTORY of the review's run dir, and returns lines to
// print under a `▸ MUTATION (advisory)` heading.
//
// The subdirectory is not tidiness. A semantic mutation panel dispatches engines,
// and engine dispatch writes `<engineId>-output.txt` into the output dir it is
// given — the exact filenames that hold the review's own canonical per-engine
// evidence. Sharing the directory silently overwrote the review with the
// mutation panel's answers, and `--verbose` then replayed mutation prompts as if
// they were the review.
//
// HARD CONTRACT: it never influences the review. No exception escapes, no
// consensus is touched, no exit code or run-status.ok is changed — a mutation
// failure degrades to a single explanatory line. Mutation score is noisy
// (equiv-prone operators); making it a gate was rejected in the spec.

import from="node:fs" names="mkdirSync"
import from="node:path" names="join"
import from="@kernlang/agon-core" names="discoverGate"
import from="@kernlang/agon-core" names="Mutant,MutationReport,EngineRegistry,EngineAdapter" types=true
import from="@kernlang/agon-forge" names="runMutate"
import from="../handlers/engine-filter.js" names="filterDefaultOrchestrationEngines"
import from="./mutate-render.js" names="renderMutationLines"

interface name=ReviewMutationOptions export=true
  field name=repoRoot type=string
  field name=diff type=string
  field name=outputDir type=string
  field name=registry type=EngineRegistry
  field name=adapter type=EngineAdapter
  field name=engines type="string[]" doc="The roster the REVIEW resolved (already narrowed by --engines/--risk/--primary-engine), not the whole active list: a user who narrowed the review panel narrowed their spend, and the mutation panel must not quietly widen it again. Narrowed further with filterDefaultOrchestrationEngines here so the caller stays a one-liner."
  field name=semantic type=boolean doc="Mechanical-only is the default (cheap, no engine spend, no source leaves the machine) — the same default `agon mutate` has. --mutate-semantic opts into the panel."
  field name=testCmd type=string optional=true
  field name=buildCmd type=string optional=true
  field name=typecheckCmd type=string optional=true
  field name=maxMutants type=number optional=true
  field name=perMutantTimeoutSec type=number optional=true
  field name=totalBudgetSec type=number optional=true
  field name=signal type=AbortSignal optional=true

fn name=firstLine params="text:string|undefined|null" returns=string export=true
  doc "The first non-empty line of a multi-line error, capped at 200 chars — enough for a reader to recognise WHY the advisory pass produced nothing, without dumping a whole stack trace into the review output. Pure."
  handler <<<
    const head = (text ?? '').split('\n').map((l) => l.trim()).find((l) => l.length > 0) ?? '';
    return head.length > 200 ? `${head.slice(0, 200)}…` : head;
  >>>

fn name=reviewMutateOverrides params="args:Record<string,unknown>" returns="{ testCmd?: string; buildCmd?: string }" export=true
  doc "Read the `agon review --mutate-test/--mutate-build` passthrough off the raw citty args. Without them the advisory pass can only use the discovered gate, so a suite that runs against a prebuilt dist all-survives with no in-command remedy. citty keeps kebab-case flags as literal keys, so both spellings are read. Lives here (not in review.ts) so the review command file stays a thin caller."
  handler <<<
    const str = (key: string): string | undefined => {
      const raw = args[key];
      return typeof raw === 'string' && raw.trim() ? raw.trim() : undefined;
    };
    return {
      testCmd: str('mutate-test') ?? str('mutateTest'),
      buildCmd: str('mutate-build') ?? str('mutateBuild'),
    };
  >>>

fn name=runReviewMutation async=true params="opts:ReviewMutationOptions" returns="Promise<string[]>" export=true
  doc "Run the advisory mutation pass over an already-resolved review diff and return the lines to print (heading included). Artifacts land in `<outputDir>/mutation/`, never in the review dir itself — engine dispatch writes `<engineId>-output.txt` and would otherwise overwrite the review's own per-engine evidence. NEVER throws and NEVER signals failure to the caller — a missing test command, an empty diff or a runtime error all come back as one explanatory line, so the review's exit code and consensus stay untouched."
  handler <<<
    const heading = '\n▸ MUTATION (advisory)';
    try {
      if (!opts.diff.trim()) return [heading, '  skipped — no diff to mutate'];
      const testCmd = (opts.testCmd ?? '').trim() || discoverGate(opts.repoRoot).command.trim();
      if (!testCmd) {
        return [heading, '  skipped — no test command discovered (add a package.json test script or a `fitness:` brief line, or run `agon mutate --test "<cmd>"`)'];
      }
      // Never the review's own run dir — see the header note on engine-output
      // collision. mkdir here so runMutate never has to create it under a
      // half-written review.
      const mutationDir = join(opts.outputDir, 'mutation');
      try { mkdirSync(mutationDir, { recursive: true }); } catch { /* runMutate reports a real IO failure */ }
      const result = await runMutate({
        repoRoot: opts.repoRoot,
        diff: opts.diff,
        testCmd,
        buildCmd: opts.buildCmd,
        typecheckCmd: opts.typecheckCmd,
        engines: opts.semantic ? filterDefaultOrchestrationEngines(opts.engines) : [],
        registry: opts.registry,
        adapter: opts.adapter,
        semantic: opts.semantic,
        maxMutants: opts.maxMutants ?? 25,
        perMutantTimeoutSec: opts.perMutantTimeoutSec ?? 120,
        totalBudgetSec: opts.totalBudgetSec ?? 600,
        outputDir: mutationDir,
        signal: opts.signal,
      });
      const lines = [heading, `  test command: ${testCmd}`, ...renderMutationLines(result.report, result.survivors, { grouped: true })];
      // Swallowing the failure must not swallow the FORENSICS: name the reason
      // ONCE. A red baseline is already rendered by the renderer's `skipped —`
      // line; repeating result.error there printed the same (uncapped) log twice,
      // which is exactly what firstLine() exists to prevent.
      if (!result.ok) {
        const baselineWhy = firstLine(result.report?.baselineError);
        const runWhy = firstLine(result.error);
        if (runWhy && runWhy !== baselineWhy) lines.push(`  run failed — ${runWhy}`);
        else if (!baselineWhy) lines.push('  run failed — no reason reported');
        lines.push(`  (advisory only — the review verdict above is unaffected)`);
      }
      // Name a path only when one EXISTS. Synthesizing `<dir>/mutation-report.json`
      // sent readers to a file that was never written whenever the run died
      // before persistence.
      if (result.reportPath) lines.push(`  Report: ${result.reportPath}`);
      else lines.push(`  (no report written — the run produced nothing to persist; see ${mutationDir})`);
      return lines;
    } catch (err) {
      // Advisory means advisory: swallow everything — but always point at the
      // subdir, which is where a partial mutation-report.json would have landed.
      return [
        heading,
        `  skipped — mutation pass failed: ${err instanceof Error ? err.message : String(err)}`,
        `  (report, if any, under ${join(opts.outputDir, 'mutation')})`,
      ];
    }
  >>>
