// ── Mutate reflex — "your tests pass; would they NOTICE a bug?" ─────────
//
// The mode nobody remembers to run is the one that measures the thing everyone
// assumes. A turn that ends "all tests pass" has proved the suite is GREEN, not
// that it is DISCRIMINATING, and that gap is exactly what `agon mutate` exists
// to close. So the reflex fires on the two moments where the gap is live:
//   • Cesar's own turn CLAIMS the tests pass / that it added tests / all green.
//   • The USER questions the tests ("are these real?", "would they catch it?").
//
// Same shape as delegation-reflex.kern: a PURE, veto-first assessment plus one
// line of surfacing, and nothing runs. The surfacing follows the C4 in-flow
// escalation line (confidence.kern) exactly — one dim suggestion appended to the
// turn, at most once, which the user takes by typing the command. Never a modal,
// never an auto-run, never a spend the user did not ask for.
//
// The LENS is decided from the files the turn actually WROTE, against review's
// own sensitive-path evidence (REVIEW_SENSITIVE_PATH_RE) plus the family map
// that turns "sensitive" into a NAME the panel can be steered by. Sharing the
// review regex is the point: two drifting definitions of "high risk" is exactly
// the bug this reuse prevents. When those files look like auth/session/token,
// quota, or persistence/user-data work, a bare mechanical run is the wrong
// suggestion — the bugs worth proposing there are semantic ones.

import from="../handlers/review-router.js" names="REVIEW_SENSITIVE_PATH_RE"

interface name=MutateReflex export=true
  field name=decision type="'none' | 'suggest'"
  field name=trigger type="'test-claim' | 'test-doubt' | 'none'"
  field name=command type=string doc="The exact command the user would type. Empty when decision is 'none'."
  field name=lens type=string optional=true doc="The preset the suggested command carries, when the changed paths made a semantic run the honest suggestion."
  field name=reasons type="string[]"
  field name=vetoes type="string[]"

const name=MUTATE_TEST_CLAIM_RE type=RegExp value={{ /\b(?:all (?:\d+ )?(?:the )?tests? (?:now )?pass(?:ing|ed)?|tests? (?:are |now )?(?:all )?(?:pass(?:ing|ed)?|green)|suite (?:is )?(?:green|pass(?:ing|es|ed)?)|all green|everything(?:'s| is) green|added (?:a |some |new )?(?:unit |integration |regression )?tests?|wrote (?:a |some |new )?(?:unit |integration |regression )?tests?|test coverage (?:is|looks) (?:good|complete)|gate (?:is )?green)\b/i }}
  doc "A turn's own claim that the suite is green or that tests were added. Deliberately narrow: it must be a CLAIM about test outcome, not any sentence containing the word 'test' — the reflex costs the user a line of attention every time it fires."

const name=MUTATE_TEST_DOUBT_RE type=RegExp value={{ /\b(?:are (?:these|the|my|those) tests? (?:real|any good|actually|good enough|meaningful|worth)|(?:is|are) (?:this|that|these|the) tests? (?:real|fake)|would (?:the |my |these |those )?tests? (?:actually )?(?:catch|notice|fail|detect)|(?:do|does|will) (?:the |my |these |those )?tests? (?:actually )?(?:catch|notice|detect)|test strength|are (?:my|the|these) tests? fake|good enough tests?|how strong are (?:my|the|these) tests?)\b/i }}
  doc "The user asking whether the tests are worth anything. This is a direct request for the oracle, so it outranks every veto that exists to keep the reflex quiet on unsolicited turns."

const name=MUTATE_ALREADY_RUN_RE type=RegExp value={{ /(?:^|\s)\/mutate\b|\bagon mutate\b|\bmutation (?:score|report|testing)\b|\bsurvivor\(s\)\b/i }}
  doc "Evidence that mutation testing is already in the conversation — a suggestion to run what just ran (or what the user is already typing) is noise."

const name=MUTATE_LENS_PATH_RULES type="Array<{lens:string, re:RegExp}>" value={{ [
  { lens: 'security', re: /(^|\/)(auth|authentication|sessions?|tokens?|oauth|oidc|passwords?|passkeys?|permissions?|rbac|acl|login|credentials?)(\/|[._-]|$)/i },
  { lens: 'ratelimit', re: /(^|\/)(rate[-_]?limit\w*|throttl\w*|quota\w*|budget\w*|billing)(\/|[._-]|$)/i },
  { lens: 'privacy', re: /(^|\/)(migrations?|schemas?|database|db|prisma|drizzle|users?|profiles?|accounts?|pii|telemetry|analytics)(\/|[._-]|$)/i },
] }}
  doc "Path family -> lens, in PRIORITY order: a diff touching both auth and a migration is a security question first. These are the families that MAP to a lens; review's own REVIEW_SENSITIVE_PATH_RE is the backstop for the rest (protocol/contract, deploy, release), which fall back to the security lens."

fn name=mutateLensForPaths params="paths:string[]" returns="string|null" export=true
  doc "The `--lens` a set of changed paths earns, or null when none of them is high-risk. First match wins in priority order (security > ratelimit > privacy); a path that review's own REVIEW_SENSITIVE_PATH_RE calls sensitive but that belongs to no lens family (a protocol/contract, deploy or release path) falls back to `security`, so the shared definition of 'sensitive' is never narrowed here — only extended by the rate-limit family, which review has no reason to track and mutation very much does. Pure."
  handler <<<
    const candidates = paths.filter((p) => typeof p === 'string' && p.trim().length > 0);
    for (const rule of MUTATE_LENS_PATH_RULES) {
      if (candidates.some((p) => rule.re.test(p))) return rule.lens;
    }
    // Sensitive by review's standard but in no family with its own lens
    // (a protocol/contract or deploy path): security is the honest default —
    // it is the family whose bugs a passing suite most often fails to notice.
    if (candidates.some((p) => REVIEW_SENSITIVE_PATH_RE.test(p))) return 'security';
    return null;
  >>>

fn name=assessMutateReflex params="a:{input:string, response:string, paths?:string[]}" returns=MutateReflex export=true
  doc "Should this turn suggest `/mutate`? Veto-first, exactly like the delegation reflex. Suggests on (1) a USER question about whether the tests are real — which outranks the vetoes, because it IS the ask — or (2) Cesar's own claim that the tests pass / that it added tests. Vetoed when mutation is already in the conversation, when the turn produced no response text, or when the claim came without either a test claim or a doubt. High-risk changed paths upgrade the suggested command to `--semantic --lens <family>`. Pure — the caller decides how to surface it."
  handler <<<
    const input = String(a.input ?? '');
    const response = String(a.response ?? '');
    const paths = (a.paths ?? []).filter((p) => typeof p === 'string' && p.trim().length > 0);
    const vetoes: string[] = [];
    const reasons: string[] = [];
    const none = (trigger: MutateReflex['trigger']): MutateReflex => ({ decision: 'none', trigger, command: '', reasons, vetoes });

    const doubt = MUTATE_TEST_DOUBT_RE.test(input);
    const claim = MUTATE_TEST_CLAIM_RE.test(response);
    if (!doubt && !claim) {
      vetoes.push('no-test-claim-or-doubt');
      return none('none');
    }
    // Already in the conversation, on either side: suggesting the mode that is
    // being discussed (or was just run) is the reflex being annoying.
    if (MUTATE_ALREADY_RUN_RE.test(input) || MUTATE_ALREADY_RUN_RE.test(response)) {
      vetoes.push('mutation-already-in-conversation');
      return none(doubt ? 'test-doubt' : 'test-claim');
    }
    // A claim needs a turn that actually said something — a bare "tests pass"
    // stub is not a report. A doubt is the user's own question and stands alone.
    if (!doubt && response.trim().length < 12) {
      vetoes.push('response-too-short');
      return none('test-claim');
    }
    const lens = mutateLensForPaths(paths);
    const trigger: MutateReflex['trigger'] = doubt ? 'test-doubt' : 'test-claim';
    reasons.push(doubt ? 'the user asked whether the tests are real' : 'the turn claims the suite is green or that tests were added');
    if (lens) reasons.push(`changed paths look ${lens}-sensitive`);
    const command = lens ? `/mutate --semantic --lens ${lens}` : '/mutate';
    return { decision: 'suggest', trigger, command, lens: lens ?? undefined, reasons, vetoes };
  >>>

fn name=buildMutateSuggestionLine params="reflex:MutateReflex" returns="string|null" export=true
  doc "The dim, in-flow one-liner appended below a qualifying turn — the same surfacing the sub-threshold confidence nudge uses (confidence.kern's buildEscalationSuggestionLine), for the same reason: no modal, no round-trip, no spend. The user takes it by typing the command. Null when the reflex did not fire. Pure."
  handler <<<
    if (reflex.decision !== 'suggest' || !reflex.command) return null;
    const dim = '\x1b[2m';
    const reset = '\x1b[0m';
    const why = reflex.trigger === 'test-doubt'
      ? 'passing tests only prove they are green'
      : 'green tests are not the same as strong tests';
    return `${dim}${why} — want \`${reflex.command}\` to see which of them a real bug would slip past?${reset}`;
  >>>

fn name=mutatedPathFromToolArgs params="tool:string, args?:Record<string,unknown>" returns="string|null" export=true
  doc "The repo path a write-tool call touched, from its arguments — `file_path` (Edit/Write/MultiEdit), `path`, or `notebook_path`. Null for a tool with no path argument (Bash, and every read tool). Pure; the caller decides which tools count as writes."
  handler <<<
    if (!args) return null;
    const keys = ['file_path', 'filePath', 'path', 'notebook_path', 'notebookPath', 'target_file'];
    for (const key of keys) {
      const raw = args[key];
      if (typeof raw === 'string' && raw.trim()) return raw.trim();
    }
    return null;
  >>>
