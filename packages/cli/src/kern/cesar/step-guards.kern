// ── Cesar step guards — effect-classified, intent-aware read-spiral notes ──
// Pure policy for the native tool loop's mid-turn guard channel (the advisory
// that rides the NEXT tool result Cesar reads). Companion to the core effect
// classifier (step-effect.kern): core says WHAT a step did, this says when the
// harness should say something about it.
//
// Two intents, two different asks — the nero-validated split. An EDIT turn that
// has read 25 files and mutated/verified NOTHING is stalling: mapping is done,
// summarize and either implement or ask ONE question. An INVESTIGATE turn is
// SUPPOSED to read a lot, so volume alone is never a stall there; only genuine
// read-REPEATS are, and the ask is "summarize and answer" — an investigate turn
// must never be told to implement.
//
// Every note fires at most once per turn (the caller latches it), and the
// thresholds are config policy, never hardcoded behavior.

import from="@kernlang/agon-core" names="AgonConfig" types=true

type name=ReadSpiralIntent values="edit|investigate" export=true

const name=CESAR_SEARCH_NUDGE_DEFAULT type=number value=40
  doc "Default for config.cesarSearchNudgeThreshold: read-class steps in one turn before the CODEBASE-BRIEF advisory fires."

const name=CESAR_READ_SPIRAL_DEFAULT type=number value=25
  doc "Default for config.cesarReadSpiralThreshold: read-class steps with zero mutate/verify before the edit-intent checkpoint fires."

const name=CESAR_READ_REPEAT_DEFAULT type=number value=12
  doc "Default for config.cesarReadRepeatThreshold: read-REPEAT steps before the investigate-intent checkpoint fires."

const name=EDIT_INTAKE_KINDS type="Set<string>" value={{ new Set(['quick-fix', 'bug', 'feature', 'big-feature', 'spec']) }}
  doc "Router intake kinds whose turns are expected to end in a change. Everything else (chat, review, decision, exploration, unknown) is treated as investigate — the conservative side, because the investigate note never tells Cesar to implement."

fn name=resolveGuardThreshold params="value:unknown, fallback:number" returns=number export=true
  doc "Read one numeric guard threshold from config. A finite value >= 1 wins (floored); anything else — unset, 0, negative, NaN, a string — falls back to the compiled default. Non-positive MUST mean 'unset': KERN codegen emits an optional number field as 0 into DEFAULT_AGON_CONFIG (the same quirk experience.kern documents for its retrieval gates), and loadConfig merges those defaults, so a never-configured threshold arrives as 0. It also stops a malformed config value from silently disabling a guard."
  handler lang="kern"
    let name=parsed value="Number(value)"
    if cond="!Number.isFinite(parsed) || parsed < 1"
      return value="fallback"
    return value="Math.floor(parsed)"

fn name=cesarSearchNudgeThreshold params="config?:AgonConfig" returns=number export=true
  doc "Read-class steps per turn before the one-shot CODEBASE-BRIEF advisory. config.cesarSearchNudgeThreshold, default 40."
  handler lang="kern"
    return value="resolveGuardThreshold(config?.cesarSearchNudgeThreshold, CESAR_SEARCH_NUDGE_DEFAULT)"

fn name=cesarReadSpiralThreshold params="config?:AgonConfig" returns=number export=true
  doc "Read-class steps with zero mutate/verify before the edit-intent read-spiral checkpoint. config.cesarReadSpiralThreshold, default 25."
  handler lang="kern"
    return value="resolveGuardThreshold(config?.cesarReadSpiralThreshold, CESAR_READ_SPIRAL_DEFAULT)"

fn name=cesarReadRepeatThreshold params="config?:AgonConfig" returns=number export=true
  doc "Read-REPEAT steps before the investigate-intent read-spiral checkpoint. config.cesarReadRepeatThreshold, default 12."
  handler lang="kern"
    return value="resolveGuardThreshold(config?.cesarReadRepeatThreshold, CESAR_READ_REPEAT_DEFAULT)"

fn name=refundContinuationForSteeringYield params="continuations:number" returns=number export=true
  doc "Give back the continuation slot a steering-yield round consumed. The harness ENDED that round itself to hand the turn to the user, so it is neither the model failing to progress (the caller skips the no-progress strike by continuing the loop) nor a harness retry against MAX_CONTINUATIONS. Never goes below zero."
  handler lang="kern"
    return value="Math.max(0, Number(continuations ?? 0) - 1)"

fn name=readSpiralIntentFor params="intakeKind?:string" returns=ReadSpiralIntent export=true
  doc "Map the router's intake kind onto the guard's two intents. Only change-shaped intakes (quick-fix/bug/feature/big-feature/spec) are edit-intent; every other or missing value is investigate, so an unclassified turn can never be pushed toward implementing."
  handler lang="kern"
    return value="EDIT_INTAKE_KINDS.has(String(intakeKind ?? '').trim().toLowerCase()) ? 'edit' : 'investigate'"

fn name=shouldNoteReadSpiral params="opts:{intent:string, readSteps:number, readRepeats:number, effectfulSteps:number, shellWorkSteps?:number, spiralThreshold:number, repeatThreshold:number, alreadyNoted:boolean}" returns=boolean export=true
  doc "One-shot read-spiral checkpoint predicate. Edit intent: at least spiralThreshold read-class steps AND zero effectful (mutate/verify) steps AND zero shell-work steps — a mapping pass that never turned into work. Investigate intent: read VOLUME is legitimate, so it fires only on at least repeatThreshold read-REPEATS. Never fires twice (alreadyNoted). shellWorkSteps is the honesty guard on the edit branch: a turn that did its work through the shell (`sed -i …`, `git commit`, `mkdir`, a build script) classifies as `other`, never mutate/verify, so on effectfulSteps alone the note would tell an engine that just edited files 'no edit or verification yet'. `other`-class Bash is precisely the shell we could NOT prove read-only, so it must count as work happening here — the classifier stays untouched (other remains budget-neutral) and only this note is suppressed. The cost is a false NEGATIVE on an unclassifiable read wrapper (`python -c \"…read()\"`) — the accepted-leak side of the spec, caught one layer up by the novelty-based no-progress checkpoint."
  handler lang="kern"
    if cond="opts.alreadyNoted"
      return value="false"
    if cond="readSpiralIntentFor(opts.intent) === 'investigate'"
      return value="Number(opts.readRepeats ?? 0) >= Number(opts.repeatThreshold ?? CESAR_READ_REPEAT_DEFAULT)"
    if cond="Number(opts.effectfulSteps ?? 0) > 0 || Number(opts.shellWorkSteps ?? 0) > 0"
      return value="false"
    return value="Number(opts.readSteps ?? 0) >= Number(opts.spiralThreshold ?? CESAR_READ_SPIRAL_DEFAULT)"

fn name=readSpiralNote params="intent:string, readSteps:number, readRepeats:number" returns=string export=true
  doc "The machine-authored guard note appended to the next tool result. Edit intent asks for a summary then implementation-or-one-question; investigate intent asks for a summary and the ANSWER and deliberately never says 'implement'. Wording is bounded and states the observation before the ask, so the model can see why it arrived."
  handler lang="kern"
    if cond="readSpiralIntentFor(intent) === 'investigate'"
      return value="`[NOTE] ${Number(readRepeats ?? 0)} of your ${Number(readSteps ?? 0)} read/search calls this turn re-read something you already read. You have the material — summarize what you found and answer the question now. If a specific detail is genuinely missing, read exactly that one thing.`"
    return value="`[NOTE] ${Number(readSteps ?? 0)} read/search calls this turn and no edit or verification yet. Mapping looks complete — summarize what you found, then either make the change or ask me ONE question if you are blocked on a decision. Do not keep reading.`"
