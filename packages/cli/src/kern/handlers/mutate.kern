// ── /mutate — mutation testing in the REPL ─────────────────────────────
//
// Same core as `agon mutate` (runMutate from agon-forge), rendered through the
// TUI dispatch instead of stdout: progress lines land as transcript info blocks,
// survivors as a table, and a CAPPED verdict summary is appended to the chat
// session so Cesar can act on "these tests are fake" in the next turn.
//
// This file also owns the shared, PURE decision surface the CLI command
// re-uses — target-grammar resolution, flag parsing, contradictory-flag
// rejection, and the semantic-panel resolution — so both surfaces behave
// identically. The same split as handlers/review.kern vs commands/review.ts.
// Rendering lives one door over in blocks/mutate-render.kern.

import from="@kernlang/agon-core" names="ensureAgonHome,createRunDir,writeRunStatus,appendMessage,resolveWorkingDir,discoverGate,spawnWithTimeout"
import from="@kernlang/agon-core" names="RunStatus,RunStatusEngine" types=true
import from="@kernlang/agon-forge" names="runMutate,mutateVerdictLine"
import from="./engine-filter.js" names="filterDefaultOrchestrationEngines"
import from="./review.js" names="resolveReviewTarget,resolveAutoReviewBase"
import from="../blocks/mutate-render.js" names="renderMutationLines,formatMutateProgressLine,mutateSpendLine,mutateActualSpendLine,mutateChatSummary,mutationScorePct,mutateLensLine,mutateLensImpliesSemanticLine"
import from="../../handlers/types.js" names="Dispatch,HandlerContext" types=true

const name=MUTATE_TARGET_GRAMMAR type=RegExp value={{ /^(uncommitted$|branch:|commit:|range:)/ }}

fn name=parsePositiveInt params="raw:unknown, fallback:number" returns=number export=true
  doc "Parse a numeric flag, falling back when empty/NaN/non-positive. Pure."
  handler <<<
    const text = String(raw ?? '').trim();
    if (!text) return fallback;
    const n = Number(text);
    if (!Number.isFinite(n) || n <= 0) return fallback;
    return Math.floor(n);
  >>>

fn name=currentBranchName async=true params="cwd:string" returns="Promise<string>" export=true
  doc "The checked-out branch name, or '' when git cannot say. ASYNC on purpose: this runs inside the REPL's event loop, and the synchronous execFileSync it replaced froze the whole TUI — typing, spinner and abort included — for the length of a git spawn on every `/mutate` without an explicit --diff."
  handler <<<
    try {
      const res = await spawnWithTimeout({ command: 'git', args: ['rev-parse', '--abbrev-ref', 'HEAD'], cwd, timeout: 10_000 });
      return (res.stdout ?? '').trim();
    } catch {
      return '';
    }
  >>>

fn name=resolveMutateDiff async=true params="diffArg:string|undefined, baseArg:string|undefined, cwd:string" returns="Promise<{diff:string, label:string}>" export=true
  doc "Resolve the diff to mutate using the EXACT review target grammar (uncommitted | branch:NAME | commit:SHA | range:BASE...TARGET, composed with --base). A --diff value that is not one of those is treated as a BASE REF (`--diff origin/main` = changed lines vs origin/main). With neither flag the base is auto-resolved from origin/HEAD, falling back to origin/main. Async so the branch read mutate itself adds never blocks the REPL event loop (resolveReviewTarget stays synchronous — it is review's own shared resolver, not a copy this mode owns)."
  handler <<<
    const raw = (diffArg ?? '').trim();
    const base = (baseArg ?? '').trim();
    if (raw) {
      if (MUTATE_TARGET_GRAMMAR.test(raw)) return resolveReviewTarget(raw, cwd, base || undefined);
      if (base) throw new Error(`--base does not compose with --diff ${raw} (which is already a base ref). Pass one of them.`);
      return resolveReviewTarget('uncommitted', cwd, raw);
    }
    if (base) return resolveReviewTarget('uncommitted', cwd, base);
    const branch = await currentBranchName(cwd);
    const auto = resolveAutoReviewBase(cwd, branch) ?? 'origin/main';
    return resolveReviewTarget('uncommitted', cwd, auto);
  >>>

interface name=MutateArgs export=true
  field name=path type=string optional=true
  field name=diff type=string optional=true
  field name=base type=string optional=true
  field name=test type=string optional=true
  field name=typecheck type=string optional=true
  field name=build type=string optional=true
  field name=engines type="string[]" optional=true
  field name=lens type=string optional=true doc="Free text or a preset key (security|privacy|perf|ratelimit|concurrency) steering the semantic panel. Implies --semantic."
  field name=semantic type=boolean
  field name=mechanicalOnly type=boolean
  field name=maxMutants type=number
  field name=semanticPerEngine type=number
  field name=timeout type=number
  field name=budget type=number
  field name=error type=string optional=true doc="Set when the raw argument string is malformed (e.g. a boolean flag given as --flag=value). The handler dispatches it and stops. Every malformed flag in one string is reported together, so the user fixes them in one pass instead of one rerun each."

fn name=parseMutateArgs params="input:string" returns=MutateArgs export=true
  doc "Parse the REPL argument string for /mutate. Flags mirror the CLI one-for-one; whatever is left after the flags is the positional path. Both `--flag value` and `--flag=value` are accepted for value flags, quoted values may contain spaces (`--engines \"codex, kimi\"`), and a boolean flag given a value is rejected rather than reinterpreted. Pure."
  handler <<<
    // INVARIANT: `rest` stays space-padded at both ends for the whole function.
    // Every flag pattern below anchors on a preceding space via lookbehind and
    // (for booleans) a following space via lookahead, so a flag at either end of
    // the user's string still matches, and `-e` can never match the tail of
    // `--semantic-per-engine`. Replacements substitute a single space, never ''.
    let rest = ` ${input.trim()} `;
    const errors: string[] = [];
    // `--flag value`, `--flag=value`, quoted or bare.
    const take = (flag: string): string | undefined => {
      const re = new RegExp(`(?<=\\s)${flag}(?:=|\\s+)("[^"]*"|'[^']*'|\\S+)`);
      const m = rest.match(re);
      if (!m) return undefined;
      rest = rest.replace(m[0], ' ');
      const raw = m[1] ?? '';
      // Strip only a MATCHED quote pair — a lone quote is part of the value, not
      // a delimiter, and stripping it independently silently mangles the command.
      const quoted = raw.length >= 2 && (raw[0] === '"' || raw[0] === "'") && raw[raw.length - 1] === raw[0];
      return (quoted ? raw.slice(1, -1) : raw).trim() || undefined;
    };
    const test = take('--test');
    const typecheck = take('--typecheck');
    const build = take('--build');
    const diff = take('--diff');
    const base = take('--base');
    const enginesRaw = take('(?:--engines|-e)');
    const lens = take('--lens');
    const maxMutants = parsePositiveInt(take('--max-mutants'), 40);
    const semanticPerEngine = parsePositiveInt(take('--semantic-per-engine'), 8);
    const timeout = parsePositiveInt(take('--timeout'), 120);
    const budget = parsePositiveInt(take('--budget'), 900);
    // Boolean flags: consume EVERY occurrence (a repeated `--semantic --semantic`
    // used to leave the second one in `rest`, where it collapsed into the
    // positional path and failed as a missing file), and consume an optional
    // `=value` suffix too so `--mechanical-only=true` can never leak `=true`
    // into the path. An `=`-form is a user error, not a value to interpret.
    const takeBool = (flag: string): boolean => {
      const re = new RegExp(`(?<=\\s)--${flag}(=\\S*)?(?=\\s)`);
      let seen = false;
      let m = rest.match(re);
      while (m) {
        seen = true;
        rest = rest.replace(m[0], ' ');
        if (m[1] !== undefined) {
          errors.push(`--${flag} is a boolean flag — pass it bare (\`--${flag}\`), not \`--${flag}${m[1]}\`.`);
        }
        m = rest.match(re);
      }
      return seen;
    };
    const mechanicalOnly = takeBool('mechanical-only');
    const semantic = takeBool('semantic');
    const path = rest.replace(/\s+/g, ' ').trim() || undefined;
    return {
      path, diff, base, test, typecheck, build, lens,
      engines: enginesRaw ? enginesRaw.split(',').map((s) => s.trim()).filter(Boolean) : undefined,
      semantic, mechanicalOnly, maxMutants, semanticPerEngine, timeout, budget,
      error: errors.length > 0 ? errors.join(' ') : undefined,
    };
  >>>

fn name=validateMutateFlags params="a:{path?:string, diff?:string, base?:string, lens?:string, semantic?:boolean, mechanicalOnly?:boolean}" returns="string|null" export=true
  doc "Reject contradictory `mutate` flag combinations with ONE message shared by the CLI and the REPL, or null when the combination is coherent. Pure. A positional path mutates whole files, so BOTH --diff and --base (which only resolve changed lines) are meaningless with it; --semantic and --mechanical-only are opposite intents, so passing both is always a mistake rather than a precedence puzzle; --lens implies --semantic, so it collides with --mechanical-only the same way."
  handler <<<
    const path = (a.path ?? '').trim();
    const diff = (a.diff ?? '').trim();
    const base = (a.base ?? '').trim();
    if (a.semantic === true && a.mechanicalOnly === true) {
      return 'Pass --semantic OR --mechanical-only, not both — --semantic forces the AI-semantic panel on, --mechanical-only is the (default) mechanical run.';
    }
    if ((a.lens ?? '').trim() && a.mechanicalOnly === true) {
      return 'Pass --lens OR --mechanical-only, not both — a lens steers the AI-semantic panel (so it implies --semantic), and --mechanical-only turns that panel off.';
    }
    if (path && diff) return 'Pass a path OR --diff, not both — a path mutates whole files, --diff mutates changed lines.';
    if (path && base) return 'Pass a path OR --base, not both — a path mutates whole files, --base only resolves which changed lines to mutate.';
    return null;
  >>>

interface name=MutatePanel export=true
  doc "The resolved semantic panel for one mutate run — the SAME decision on both surfaces."
  field name=semantic type=boolean
  field name=engines type="string[]"
  field name=lens type=string optional=true doc="The lens the run will steer the panel with, echoed back so the caller passes ONE resolved value to runMutate and prints ONE header line. Absent on a mechanical run."
  field name=impliedSemantic type=boolean optional=true doc="True when --semantic was NOT passed and the panel is on only because a --lens was. The surfaces say so in the header rather than silently spending engine calls the user did not ask for by name."
  field name=error type=string optional=true doc="A hard stop: an unknown engine id, or --semantic with nothing to dispatch to."
  field name=warning type=string optional=true doc="Non-fatal: the run proceeds, but something the user asked for has no effect."

fn name=resolveMutatePanel params="a:{ requested?: string[], active: string[], known: string[], resolveId: (id:string)=>string, semantic: boolean, mechanicalOnly: boolean, lens?: string, listHint: string }" returns=MutatePanel export=true
  doc "Resolve the AI-semantic panel for a mutate run — the ONE implementation the CLI command and the REPL handler both call, so `--semantic` with an empty roster cannot fail loudly on one surface and silently degrade to mechanical on the other (it did). Mutation is MECHANICAL by default: the semantic panel sends changed repository source to every selected external provider, so it is opt-in via --semantic rather than something a roster silently switches on. --mechanical-only is the explicit spelling of the default. A `--lens` IMPLIES `--semantic`: a lens can only steer engine-proposed bugs, so accepting it on a mechanical run would make the flag silently inert — the panel is turned on and `impliedSemantic` tells the caller to say so. Pure — the caller supplies the roster and the id resolver, and `listHint` names the surface's own engine-listing command. "
  handler <<<
    const requested = (a.requested ?? []).filter((s) => (s ?? '').trim().length > 0);
    const known = new Set(a.known);
    let pool: string[] = [];
    if (requested.length > 0) {
      const unknown = requested.filter((s) => !known.has(a.resolveId(s)));
      if (unknown.length > 0) {
        return { semantic: false, engines: [], error: `Unknown engine${unknown.length > 1 ? 's' : ''}: ${unknown.join(', ')}. ${a.listHint}` };
      }
      pool = requested.map((s) => a.resolveId(s));
    } else {
      pool = filterDefaultOrchestrationEngines(a.active);
    }
    const lens = (a.lens ?? '').trim();
    const impliedSemantic = a.semantic !== true && lens.length > 0;
    const semantic = (a.semantic === true || lens.length > 0) && a.mechanicalOnly !== true;
    if (semantic && pool.length === 0) {
      const asked = impliedSemantic ? '--lens (which implies --semantic)' : '--semantic';
      return { semantic: false, engines: [], error: `${asked} needs at least one active engine. ${a.listHint}` };
    }
    if (!semantic) {
      const warning = requested.length > 0
        ? `--engines is ignored without --semantic — this run is mechanical-only, so no engine is dispatched.`
        : undefined;
      return { semantic: false, engines: [], warning };
    }
    return { semantic: true, engines: pool, lens: lens || undefined, impliedSemantic };
  >>>

fn name=handleMutate params="input:string, dispatch:Dispatch, ctx:HandlerContext" returns="Promise<boolean>" async=true export=true
  signal name=mtAbort
  doc "REPL /mutate: resolve targets, run the budgeted mutant pipeline in a disposable worktree, render survivors, and append a CAPPED verdict summary to the chat session for Cesar. Returns TRUE only when a mutation report was actually produced — the caller must not feed Cesar a 'mutation testing finished' turn for a run that never started."
  handler <<<
    ensureAgonHome();
    const cwd = resolveWorkingDir();
    const args = parseMutateArgs(input);

    if (args.error) {
      dispatch({ type: 'error', message: args.error });
      return false;
    }
    const flagError = validateMutateFlags(args);
    if (flagError) {
      // A contradictory flag combination is a hard stop, not an advisory — the
      // same severity the CLI gives it, and the same severity the sibling
      // parse/unknown-engine failures below already use.
      dispatch({ type: 'error', message: flagError });
      return false;
    }

    let testCmd = (args.test ?? '').trim();
    if (!testCmd) {
      try { testCmd = discoverGate(cwd).command.trim(); } catch { testCmd = ''; }
    }
    if (!testCmd) {
      dispatch({ type: 'error', message: 'No test command discovered — pass `--test "<cmd>"`. Mutation testing needs a real suite to run per mutant; agon never guesses one.' });
      return false;
    }

    let diff = '';
    let label = args.path ?? 'target';
    if (!args.path) {
      try {
        const resolved = await resolveMutateDiff(args.diff, args.base, cwd);
        diff = resolved.diff;
        label = resolved.label;
      } catch (err) {
        dispatch({ type: 'error', message: err instanceof Error ? err.message : String(err) });
        return false;
      }
      if (!diff.trim()) {
        dispatch({ type: 'warning', message: `No changed lines to mutate for ${label}. Pass a path to mutate whole files, or --diff <base>.` });
        return false;
      }
    }

    const panel = resolveMutatePanel({
      requested: args.engines,
      active: ctx.activeEngines(),
      known: ctx.registry.listIds(),
      resolveId: (id: string) => ctx.registry.resolveId(id),
      semantic: args.semantic,
      mechanicalOnly: args.mechanicalOnly,
      lens: args.lens,
      listHint: 'Run /engines to see available engines.',
    });
    if (panel.error) {
      dispatch({ type: 'error', message: panel.error });
      return false;
    }
    if (panel.warning) dispatch({ type: 'warning', message: panel.warning });
    const semantic = panel.semantic;
    const pool = panel.engines;

    dispatch({ type: 'header', title: `Mutate: ${label} · ${semantic ? `semantic panel (${pool.length})` : 'mechanical only'}` });
    // A lens the user passed without --semantic just turned the panel (and its
    // spend) on — say so BEFORE the spend line, not after the bill.
    if (panel.impliedSemantic) {
      const impliedLine = mutateLensImpliesSemanticLine(panel.lens);
      if (impliedLine) dispatch({ type: 'info', message: impliedLine });
    }
    const lensLine = mutateLensLine(semantic, panel.lens);
    if (lensLine) dispatch({ type: 'info', message: lensLine });
    const spendLine = mutateSpendLine(semantic, pool.length);
    if (spendLine) dispatch({ type: 'info', message: spendLine });
    dispatch({ type: 'info', message: `test: ${testCmd}` });
    ctx.setActiveAbort(mtAbort);

    const startedAt = new Date().toISOString();
    const { path: outputDir } = createRunDir({ mode: 'mutate', label: undefined, announce: false });

    try {
      const result = await runMutate({
        repoRoot: cwd,
        cwd,
        diff: args.path ? undefined : diff,
        files: args.path ? [args.path] : undefined,
        testCmd,
        typecheckCmd: args.typecheck,
        buildCmd: args.build,
        semantic,
        lens: panel.lens,
        engines: pool,
        registry: ctx.registry,
        adapter: ctx.adapter,
        maxMutants: args.maxMutants,
        semanticPerEngine: args.semanticPerEngine,
        perMutantTimeoutSec: args.timeout,
        totalBudgetSec: args.budget,
        outputDir,
        signal: mtAbort.signal,
        onEvent: (e) => {
          const line = formatMutateProgressLine(e);
          if (line) dispatch({ type: 'info', message: line });
        },
      });

      const scoreText = mutationScorePct(result.report);
      const status: RunStatus = {
        mode: 'mutate',
        label,
        startedAt,
        endedAt: new Date().toISOString(),
        engines: pool.map((id): RunStatusEngine => ({ id, status: result.ok ? 'ok' : 'error', detail: semantic ? 'semantic mutants' : 'not used' })),
        summary: result.ok
          ? `mutation score ${scoreText} — ${result.survivors.length} survivor(s) of ${result.report.killed + result.report.survived} mutant(s)`
          : (result.error ?? 'mutate failed'),
        ok: result.ok,
        requested: pool,
        timeoutSec: args.timeout,
      };
      writeRunStatus(outputDir, status);

      if (!result.ok) {
        dispatch({ type: 'error', message: result.error ?? 'Mutation run failed.' });
        dispatch({ type: 'info', message: `Saved: ${outputDir}` });
        return false;
      }

      for (const line of renderMutationLines(result.report, result.survivors)) dispatch({ type: 'info', message: line });
      const actualSpend = mutateActualSpendLine(semantic, result.engineCalls);
      if (actualSpend) dispatch({ type: 'info', message: actualSpend });
      const verdict = mutateVerdictLine(result.report, result.survivors);
      if (verdict.level === 'success') dispatch({ type: 'success', message: `Verdict: ${verdict.text}` });
      else dispatch({ type: 'warning', message: `Verdict: ${verdict.text}` });
      dispatch({ type: 'info', message: `Saved: ${outputDir}` });

      appendMessage(ctx.chatSession, { role: 'user', content: `[mutate] ${label}`, timestamp: new Date().toISOString() });
      appendMessage(ctx.chatSession, {
        role: 'engine',
        engineId: 'mutate',
        // CAPPED: the full table went to the transcript and the run dir. The
        // session is replayed into every later Cesar turn.
        content: mutateChatSummary({ label, testCmd, report: result.report, survivors: result.survivors, reportPath: result.reportPath ?? outputDir, lens: result.lens }),
        timestamp: new Date().toISOString(),
      });
      return true;
    } catch (err) {
      dispatch({ type: 'error', message: `Mutate failed: ${err instanceof Error ? err.message : String(err)}` });
      return false;
    }
  >>>
  cleanup <<<
    ctx.setActiveAbort(null);
  >>>
