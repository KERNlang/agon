// ── Budgeted mutant runner (shared primitive) ──────────────────────────
// Takes a pool of mutants (mechanical or AI-semantic), applies them ONE AT A
// TIME inside an already-isolated sandbox directory, runs the test command and
// classifies the result. This is the piece goal's private mutationSurvivors
// never had: a baseline, a budget, a typecheck filter and an honest timeout
// taxonomy.
//
// Semantics (binary, testable — nero-hardened):
//   • BASELINE FIRST. The unmutated build/typecheck/test commands MUST pass in
//     the sandbox before a single mutant runs. Without it a worktree missing
//     node_modules/dist reports "100% of mutants killed" while nothing was ever
//     tested (phantom kills), and a pre-existing type error marks EVERY mutant
//     `invalid` while the report still claims a clean run. A red baseline is an
//     OPERATIONAL failure, not a result: the report comes back baselineOk:false
//     + baselineError and ZERO outcomes, and the caller must exit non-zero.
//   • TIMEOUT = KILLED. Standard mutation semantics: a mutant that hangs the
//     suite has been detected. `status:'timeout'` is preserved for diagnosis and
//     also counted in `killed` / `killedByTimeout`.
//   • BUDGET EXHAUSTION ≠ TIMEOUT. The total wall clock is a REAL bound: every
//     subprocess is capped at what is left of it, and a command the BUDGET cut
//     short is never scored. Those mutants are OMITTED from `outcomes`, counted
//     in `notRun` and flagged with budgetExhausted — never folded into `killed`.
//   • ABORT ≠ EVIDENCE. A signal that fires mid-mutant leaves that mutant and
//     every one after it in `notRun` with `aborted:true` — a cancelled run can
//     never read as a completed one, and Ctrl-C can never raise the score.
//   • A MUTANT THAT CANNOT BE PLACED IS `invalid`, NEVER A THROW. No `file`, a
//     path that escapes the sandbox (lexically or through a symlink), a line out
//     of range, or a source line that no longer matches `mutant.before` — each
//     is graded `invalid` with a reason so one bad mutant cannot discard the
//     outcomes already earned, and a no-op write can never fake a survivor.
//   • Every touched file is restored from its cached original in `finally`,
//     unconditionally, and also immediately after each mutant so two mutants in
//     different files never stack.

import from="node:fs" names="readFileSync,writeFileSync"
import from="../blocks/paths.js" names="resolveWithinRoot"
import from="../blocks/process.js" names="spawnWithTimeout"
import from="./mutant-generator.js" names="applyMutantToSource"
import from="./mutant-generator.js" names="Mutant" types=true

interface name=MutantOutcome export=true
  doc "One mutant's fate. 'survived' = the tests PASSED on wrong code (a weak test). 'killed' = tests failed. 'timeout' = the mutated code hung — counted as a kill. 'invalid' = the mutant does not typecheck/build, or could not be placed at all, so it proves nothing about the tests."
  field name=mutant type=Mutant
  field name=status type="'killed'|'survived'|'invalid'|'timeout'"
  field name=durationMs type=number
  field name=exitCode type=number optional=true
  field name=reason type=string optional=true doc="Why an 'invalid' mutant was rejected (no file, escaped the sandbox, source drifted, did not typecheck/build). Never set for a graded run."

interface name=MutationReport export=true
  doc "The machine surface of a mutation run. `killed` INCLUDES timeouts; `killedByTimeout` (== `timeouts`) breaks them out. `score` = killed / (killed + survived), null when nothing ran; invalid mutants are excluded from the denominator. When baselineOk is false nothing was mutated and outcomes is empty."
  field name=testCmd type=string
  field name=worktree type=string
  field name=generated type=number
  field name=killed type=number
  field name=survived type=number
  field name=invalid type=number
  field name=timeouts type=number
  field name=killedByTimeout type=number
  field name=notRun type=number
  field name=score type="number|null"
  field name=outcomes type="MutantOutcome[]"
  field name=budgetExhausted type=boolean
  field name=aborted type=boolean doc="The caller's AbortSignal fired during the run. The mutants still pending are in notRun; a cancelled run must never be read as a completed partial one."
  field name=allSurvived type=boolean doc="At least one mutant ran and NOTHING was killed — the signature of a test command that never exercises the mutated source (prebuilt dist, wrong --test). A timeout counts as a kill, so a single hang makes this false: that is deliberate, because a hang proves the suite DOES load the mutated code."
  field name=baselineMs type=number
  field name=baselineOk type=boolean
  field name=baselineError type=string optional=true

interface name=MutantProgress export=true
  field name=phase type="'build'|'typecheck'|'baseline'|'mutant'"
  field name=index type=number
  field name=total type=number
  field name=durationMs type=number
  field name=mutantId type=string optional=true
  field name=status type=string optional=true

interface name=RunMutantsOptions export=true
  field name=worktree type=string
  field name=mutants type="Mutant[]"
  field name=testCmd type=string doc="Run through /bin/sh -c. This string, buildCmd and typecheckCmd are the USER's commands (CLI flags / a discovered gate) and must NEVER be composed from engine output — they are executed with the caller's full privileges."
  field name=perMutantTimeoutSec type=number
  field name=totalBudgetSec type=number
  field name=typecheckCmd type=string optional=true doc="Run on the unmutated baseline first (a pre-existing failure is a baseline error, not 'every mutant invalid'), then AFTER buildCmd for each mutant — a compiled target must be typechecked against its OWN build, never the previous mutant's artifacts."
  field name=buildCmd type=string optional=true doc="Run before the baseline AND FIRST for each mutant (before typecheckCmd, before the test). Defends against stale-artifact false survivors (tests run against a prebuilt dist that the mutation never reached)."
  field name=signal type=AbortSignal optional=true
  field name=onProgress type="(p:MutantProgress)=>void" optional=true

fn name=runMutants async=true params="opts:RunMutantsOptions" returns="Promise<MutationReport>" export=true
  doc "Run every mutant in an already-isolated sandbox under a total wall-clock budget that is actually enforced (every subprocess is capped by the time left). Never throws: a red baseline returns baselineOk:false + baselineError with zero outcomes, and an unplaceable mutant is graded 'invalid'. Restores every touched file in finally."
  handler <<<
    const { worktree, mutants, testCmd } = opts;
    const perMutantMs = Math.max(1, Math.round(opts.perMutantTimeoutSec * 1000));
    const budgetMs = Math.max(1, Math.round(opts.totalBudgetSec * 1000));
    const startedAt = Date.now();
    const deadline = startedAt + budgetMs;
    const originals = new Map<string, string>();
    const outcomes: MutantOutcome[] = [];
    let killed = 0;
    let survived = 0;
    let invalid = 0;
    let timeouts = 0;
    let notRun = 0;
    let budgetExhausted = false;
    let aborted = false;
    let baselineMs = 0;
    let baselineOk = false;
    let baselineError: string | undefined;

    // Every subprocess is capped at what is LEFT of the total budget, so the
    // wall clock the caller asked for is a real bound instead of a poll between
    // mutants. `budgetCut` says the BUDGET stopped this command (=> notRun),
    // not that the mutated code hung (=> timeout, which is a kill).
    const sh = async (cmd: string, timeoutMs: number): Promise<{ res: { exitCode: number; stdout: string; stderr: string; timedOut: boolean } | null; budgetCut: boolean }> => {
      const left = deadline - Date.now();
      if (left <= 0) return { res: null, budgetCut: true };
      const capped = Math.max(1, Math.min(timeoutMs, left));
      const res = await spawnWithTimeout({
        command: '/bin/sh',
        args: ['-c', cmd],
        cwd: worktree,
        timeout: capped,
        signal: opts.signal,
      });
      return { res, budgetCut: res.timedOut === true && capped < timeoutMs };
    };
    const tail = (text: string): string => String(text ?? '').trim().split('\n').slice(-6).join('\n').slice(-600);

    const build = (): MutationReport => {
      const ran = killed + survived;
      let score: number | null = null;
      if (ran > 0) score = killed / ran;
      return {
        testCmd,
        worktree,
        generated: mutants.length,
        killed,
        survived,
        invalid,
        timeouts,
        killedByTimeout: timeouts,
        notRun,
        score,
        outcomes,
        budgetExhausted,
        aborted,
        allSurvived: survived > 0 && killed === 0,
        baselineMs,
        baselineOk,
        baselineError,
      };
    };
    const budgetStop = (phase: string): MutationReport => {
      budgetExhausted = true;
      notRun = mutants.length;
      baselineError = `the total budget (${opts.totalBudgetSec}s) ran out during the sandbox ${phase}, before any mutant could run — raise the budget or narrow the target`;
      return build();
    };
    const abortStop = (phase: string): MutationReport => {
      aborted = true;
      notRun = mutants.length;
      baselineError = `aborted during the sandbox ${phase}, before any mutant ran`;
      return build();
    };

    try {
      // ── Optional build + typecheck, then the MANDATORY unmutated baseline ──
      // Each setup command is timed on its OWN clock: a 45s build and a 2s test
      // suite must not share one budget-shaped timeout, or every per-mutant
      // build times out and the whole run reports "invalid" at a clean-looking
      // 100%. Setup always gets at least 60s regardless of perMutantTimeoutSec:
      // a cold cache makes the first run of anything the slowest one.
      const setupTimeoutMs = Math.max(perMutantMs, 60_000);
      let baselineBuildMs = 0;
      let baselineTypecheckMs = 0;
      if (opts.buildCmd) {
        const t0 = Date.now();
        const r = await sh(opts.buildCmd, setupTimeoutMs);
        baselineBuildMs = Date.now() - t0;
        opts.onProgress?.({ phase: 'build', index: 0, total: mutants.length, durationMs: baselineBuildMs });
        if (!r.res || r.budgetCut) return budgetStop('build');
        if (opts.signal?.aborted) return abortStop('build');
        if (r.res.exitCode !== 0 || r.res.timedOut) {
          const why = r.res.timedOut ? 'timed out' : `exit ${r.res.exitCode}`;
          baselineError = `build command fails before any mutation in the sandbox (${why}) — check deps/build; stderr tail:\n${tail(r.res.stderr || r.res.stdout)}`;
          notRun = mutants.length;
          return build();
        }
      }
      if (opts.typecheckCmd) {
        const t0 = Date.now();
        const r = await sh(opts.typecheckCmd, setupTimeoutMs);
        baselineTypecheckMs = Date.now() - t0;
        opts.onProgress?.({ phase: 'typecheck', index: 0, total: mutants.length, durationMs: baselineTypecheckMs });
        if (!r.res || r.budgetCut) return budgetStop('typecheck');
        if (opts.signal?.aborted) return abortStop('typecheck');
        if (r.res.exitCode !== 0 || r.res.timedOut) {
          const why = r.res.timedOut ? 'timed out' : `exit ${r.res.exitCode}`;
          baselineError = `typecheck command fails before any mutation in the sandbox (${why}) — a pre-existing type error would mark EVERY mutant invalid and report a run that measured nothing; stderr tail:\n${tail(r.res.stderr || r.res.stdout)}`;
          notRun = mutants.length;
          return build();
        }
      }

      const tBase = Date.now();
      const baseRun = await sh(testCmd, setupTimeoutMs);
      baselineMs = Date.now() - tBase;
      if (!baseRun.res || baseRun.budgetCut) return budgetStop('baseline test run');
      if (opts.signal?.aborted) return abortStop('baseline test run');
      const baseRes = baseRun.res;
      opts.onProgress?.({ phase: 'baseline', index: 0, total: mutants.length, durationMs: baselineMs, status: baseRes.exitCode === 0 ? 'ok' : 'failed' });
      if (baseRes.timedOut || baseRes.exitCode !== 0) {
        const why = baseRes.timedOut ? 'timed out' : `exit ${baseRes.exitCode}`;
        baselineError = `test command fails before any mutation in the sandbox (${why}) — check deps/build; stderr tail:\n${tail(baseRes.stderr || baseRes.stdout)}`;
        notRun = mutants.length;
        return build();
      }
      baselineOk = true;

      // A suite that takes 40s unmutated needs more than a 120s cap when the
      // mutation makes it slower; a suite that takes 20ms should not wait 120s
      // for a hang either — but the user's floor always wins. Build and
      // typecheck get the SAME rule against their OWN measured baselines.
      const effTimeoutMs = Math.max(perMutantMs, 3 * baselineMs);
      const buildTimeoutMs = Math.max(perMutantMs, 3 * baselineBuildMs);
      const typecheckTimeoutMs = Math.max(perMutantMs, 3 * baselineTypecheckMs);

      // ── Mutants ──
      for (let i = 0; i < mutants.length; i += 1) {
        if (opts.signal?.aborted) { aborted = true; notRun = mutants.length - i; break; }
        if (Date.now() >= deadline) { notRun = mutants.length - i; budgetExhausted = true; break; }

        const mutant = mutants[i];
        const t0 = Date.now();

        // ── Placement: never a throw, always a grade ──
        const rel = mutant.file;
        let abs = '';
        let original = '';
        let unplaceable = '';
        if (!rel) {
          unplaceable = "no 'file' — every mutant in a multi-file run must carry its repo-relative path";
        } else {
          try {
            abs = resolveWithinRoot(worktree, rel);
            if (!originals.has(abs)) originals.set(abs, readFileSync(abs, 'utf-8'));
            original = originals.get(abs) as string;
          } catch (err) {
            abs = '';
            unplaceable = err instanceof Error ? err.message : String(err);
          }
        }
        if (!unplaceable) {
          // A no-op write is worse than no write: the (green) baseline command
          // would pass and the mutant would be counted as a SURVIVOR — a
          // fabricated weak-test signal. Verify the line still says what the
          // mutant was generated against.
          const currentLines = original.split('\n');
          const idx = mutant.line - 1;
          if (idx < 0 || idx >= currentLines.length) {
            unplaceable = `line ${mutant.line} is out of range for ${rel} (1..${currentLines.length}) — the source drifted since the mutant was generated`;
          } else if (currentLines[idx].trim() !== String(mutant.before ?? '').trim()) {
            unplaceable = `source drifted at ${rel}:${mutant.line} — the mutant expected ${JSON.stringify(String(mutant.before ?? '').trim().slice(0, 80))}, the file has ${JSON.stringify(currentLines[idx].trim().slice(0, 80))}`;
          }
        }
        if (unplaceable) {
          invalid += 1;
          const durationMs = Date.now() - t0;
          outcomes.push({ mutant, status: 'invalid', durationMs, reason: unplaceable });
          opts.onProgress?.({ phase: 'mutant', index: i + 1, total: mutants.length, durationMs, mutantId: mutant.id, status: 'invalid' });
          continue;
        }

        let status: 'killed' | 'survived' | 'invalid' | 'timeout' = 'killed';
        let exitCode: number | undefined;
        let reason: string | undefined;
        let cutByBudget = false;
        writeFileSync(abs, applyMutantToSource(original, mutant));
        try {
          let decided = false;
          // ORDER: build → typecheck → test, the SAME order the baseline ran in.
          // Typechecking first was a real contamination bug: for a compiled
          // target the typecheck reads the artifacts the PREVIOUS mutant's build
          // left behind, so this mutant can be graded against its predecessor's
          // output (and a mutant that only breaks at build time slips past the
          // "does not typecheck" gate into a fabricated survived/killed verdict).
          if (opts.buildCmd) {
            const b = await sh(opts.buildCmd, buildTimeoutMs);
            // A mutant that breaks the build proves nothing about the tests.
            if (!b.res || b.budgetCut) cutByBudget = true;
            else if (b.res.exitCode !== 0 || b.res.timedOut) { status = 'invalid'; exitCode = b.res.exitCode; reason = 'the mutated source does not build'; decided = true; }
          }
          if (!cutByBudget && !decided && opts.typecheckCmd) {
            const tc = await sh(opts.typecheckCmd, typecheckTimeoutMs);
            if (!tc.res || tc.budgetCut) cutByBudget = true;
            else if (tc.res.exitCode !== 0 || tc.res.timedOut) { status = 'invalid'; exitCode = tc.res.exitCode; reason = 'the mutated source does not typecheck'; decided = true; }
          }
          if (!cutByBudget && !decided) {
            const res = await sh(testCmd, effTimeoutMs);
            if (!res.res || res.budgetCut) cutByBudget = true;
            else {
              exitCode = res.res.exitCode;
              if (res.res.timedOut) status = 'timeout';
              else if (res.res.exitCode === 0) status = 'survived';
              else status = 'killed';
            }
          }
        } finally {
          // Restore immediately so mutants in different files never stack.
          writeFileSync(abs, original);
        }

        // Neither an abort nor a budget cut is evidence about the tests: this
        // mutant reached no verdict, so it and every mutant after it are notRun.
        if (opts.signal?.aborted) { aborted = true; notRun = mutants.length - i; break; }
        if (cutByBudget) { budgetExhausted = true; notRun = mutants.length - i; break; }

        const durationMs = Date.now() - t0;
        outcomes.push({ mutant, status, durationMs, exitCode, reason });
        if (status === 'survived') survived += 1;
        else if (status === 'invalid') invalid += 1;
        else if (status === 'timeout') { timeouts += 1; killed += 1; }
        else killed += 1;
        opts.onProgress?.({ phase: 'mutant', index: i + 1, total: mutants.length, durationMs, mutantId: mutant.id, status });
      }

      return build();
    } finally {
      for (const [absPath, content] of originals) {
        try { writeFileSync(absPath, content); } catch { /* best effort — the sandbox is disposable */ }
      }
    }
  >>>
