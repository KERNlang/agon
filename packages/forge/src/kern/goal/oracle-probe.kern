// ── agon goal — per-task oracle red-team probe (JIT) ───────────────────
// The red-team used to run ONCE per goal as a batch pre-flight, gated by a
// PERSISTED boolean (JournalState.oracleGateChecked). Two coupled defects fell
// out of that: (1) the panel red-team is STOCHASTIC, so a single clean pass was
// cached forever and every later launch — strict included — silently skipped the
// gate; (2) the batch only considered tasks whose dependencies were already
// `done`, so a verify that unblocks mid-run was never probed at all.
//
// The fix is this module: one probe per TASK, at the moment the task is picked
// (nextTask only yields dependency-satisfied tasks, so the dep filter is
// structural now), de-duplicated by an in-process Set that lives exactly as long
// as one runGoalController call. Nothing about the probe is persisted, so a
// resume/restart re-probes — which is the point: a stochastic negative must
// never become permanent.
//
// The decision itself (warn vs strict) stays in oracle-redteam.kern, unchanged.

import from="node:path" names="join"
import from="@kernlang/agon-core" names="worktreeCreate,worktreeRemoveBestEffort"
import from="./journal.js" names="logEvent,goalDir"
import from="./paths.js" names="safePathSegment"
import from="./oracle-redteam.js" names="oracleGateDecision"
import from="./types.js" names="JournalState" types=true

fn name=probeTaskOracle async=true params="a:{ state: JournalState, task: { id: string; source: string; verify?: string }, mode: string, repoRoot: string, goalId: string, baseSha: string, redTeam: (x:{tasks:Array<{id:string,source:string,verify?:string}>, baseWorktree:string, repoRoot:string, signal?:AbortSignal})=>Promise<{holes:Array<{taskId:string,engine:string,evidence:string}>, costUsd:number, errored?:boolean, errorDetail?:string}>, emit: (kind:string, taskId?:string, detail?:string)=>void, signal?: AbortSignal }" returns="Promise<{ state: JournalState; abort: boolean; summary: string; errored: boolean }>" export=true
  doc "Red-team ONE task's `verify` before it is forged: the panel tries to make the verify PASS with a deliberate CHEAT (hardcode / ignore inputs) instead of a real implementation. A winner means the oracle is non-discriminating — it would let buggy-but-passing code land green and dead-loop the run (the atan2 lesson). Runs in its own throwaway worktree off the goal branch, always removed. Returns the (possibly journal-updated, cost-updated) state plus the warn/strict decision; `errored:true` means the probe itself failed — a safety check must never abort a run with a fine oracle, and the caller must NOT mark the task as probed so it retries (the controller caps that retry per task per launch and forges the task UNPROBED past the cap, with a journaled `oracle-gate-error`). Journals ALL THREE outcomes: `oracle-gameable` per hole, `oracle-gate-ok` on a clean pass, and `oracle-gate-error` when the probe itself could not measure anything (each of the last two used to be emit-only, leaving no durable trace — exactly why the self-disabling gate was invisible in the artifact)."
  handler <<<
    let state = a.state;
    const task = a.task;
    a.emit('oracle-gate-start', task.id, `mode=${a.mode}`);
    // The task id is queue-authored; it must never author a path segment.
    const rtWt = join(goalDir(a.goalId), 'oracle-redteam', `${safePathSegment(task.id, 'task')}-${Date.now()}`);
    let holes: Array<{ taskId: string; engine: string; evidence: string }> = [];
    let errored = false;
    let errorDetail = '';
    try {
      worktreeCreate(a.repoRoot, rtWt, a.baseSha);
      const rt = await a.redTeam({
        tasks: [{ id: task.id, source: task.source, verify: task.verify }],
        baseWorktree: rtWt,
        repoRoot: a.repoRoot,
        signal: a.signal,
      });
      holes = rt.holes ?? [];
      if ((rt.costUsd ?? 0) > 0) state = { ...state, spentUsd: state.spentUsd + rt.costUsd };
      // An INCONCLUSIVE probe (forge threw, nobody dispatched, every seat failed)
      // comes back as holes: [] — indistinguishable from "nobody could cheat".
      // The red-team says so explicitly; believing the empty list would report a
      // sound oracle exactly when nothing was measured.
      if (rt.errored === true) {
        errored = true;
        errorDetail = (rt.errorDetail ?? '').trim() || 'the red-team probe did not produce a usable result';
      }
    } catch (e: unknown) {
      errored = true;
      errorDetail = e instanceof Error ? e.message : String(e);
    } finally {
      worktreeRemoveBestEffort(a.repoRoot, rtWt);
    }
    // JOURNAL the failure, don't just emit it. `emit` feeds the live CLI and is
    // gone the moment the process exits; the journal is the only durable record,
    // and "the gate ran and learned nothing" must be as auditable as a clean pass.
    if (errored) {
      state = logEvent(state, 'oracle-gate-error', task.id, errorDetail);
      a.emit('oracle-gate-error', task.id, `${errorDetail} (continuing — a safety check must never stop a run with a fine oracle; this task stays unprobed and is retried, up to the controller's per-launch attempt cap — past it the task is forged UNPROBED)`);
    }
    // Single source of truth for the warn/strict outcome (unit-tested).
    const decision = oracleGateDecision(holes, a.mode);
    if (holes.length > 0) {
      for (const h of holes) {
        state = logEvent(state, 'oracle-gameable', h.taskId, `${h.engine}: ${h.evidence}`);
        // emit too — logEvent only writes the journal; the CLI surfaces holes via onEvent.
        a.emit('oracle-gameable', h.taskId, `${h.engine}: ${h.evidence}`);
      }
      a.emit('oracle-gate-holes', task.id, holes.map((h) => `${h.taskId} gamed by ${h.engine}`).join('; '));
    } else if (!errored) {
      // JOURNAL the clean pass, don't just emit it: an auditable "this verify was
      // probed and held" is the record whose absence made the cached-pass bug
      // unprovable from the goal artifact.
      state = logEvent(state, 'oracle-gate-ok', task.id, decision.summary);
      a.emit('oracle-gate-ok', task.id, decision.summary);
    }
    return { state, abort: decision.abort, summary: decision.summary, errored };
  >>>
