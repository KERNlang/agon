// ── Naturalize: sanitize → non-author engine rewrite → re-scan ─────────────
//
// Phase 2 of the watermark-naturalization program (Phase 1 = `agon sanitize`,
// deterministic forensics in @kernlang/agon-core/text/forensics).
//
// Pipeline (per the brainstorm consensus — writer ≠ rewriter):
//   1. Deterministically clean the input (scanText/cleanText — no AI).
//   2. Dispatch ONE engine (≠ --author, the model that wrote the text) with a
//      rewrite brief: preserve meaning/structure/facts, break statistical and
//      stylometric tells, output ONLY the rewritten text.
//   3. Re-scan the rewrite. If the engine re-introduced actionable hidden
//      channels, deterministically clean again and re-verify (report says so).
//   4. Emit the naturalized text plus a word-level diff summary.
//
// Honesty contract (same as sanitize): the final re-scan proves character-level
// channels are gone, but "no statistical watermark" can NEVER be proven from
// the outside. The report always lists keyed statistical watermarks as
// residual/not assessable. This module ships no detector-evasion guarantees —
// it is a text-quality pipeline, not an evasion oracle.

import from="@kernlang/agon-core" names="EngineAdapter" types=true
import from="@kernlang/agon-core" names="EngineRegistry,scanText,cleanText"

interface name=NaturalizeOptions export=true
  field name=input type=string
  field name=engineId type=string
  field name=registry type=EngineRegistry
  field name=adapter type=EngineAdapter
  field name=author type="string|undefined"
  field name=timeout type=number
  field name=outputDir type=string
  field name=cwd type=string

interface name=NaturalizeResult export=true
  field name=ok type=boolean
  field name=engineId type=string
  field name=output type=string
  field name=initialFindings type=number
  field name=rewriteCleaned type=boolean
  field name=finalClean type=boolean
  field name=wordsBefore type=number
  field name=wordsAfter type=number
  field name=changedWords type=number
  field name=unchangedRatio type=number
  field name=residualNotAssessable type="string[]"
  field name=error type="string|undefined"

fn name=tokenizeWords params="text:string" returns="string[]"
  doc "Lowercase word tokens for the diff summary. Punctuation is stripped, so this measures lexical change, not formatting."
  handler <<<
    return text.toLowerCase().split(/[^a-z0-9']+/i).filter((w) => w.length > 0);
  >>>

fn name=wordDiffStats params="before:string, after:string" returns="{wordsBefore:number,wordsAfter:number,changedWords:number,unchangedRatio:number}" export=true
  doc "Word-level diff: multiset subtraction (not positional), so reordering reads as unchanged and genuine rewrites surface. unchangedRatio = shared words / max(before, after) — 1.0 means no lexical change."
  handler <<<
    const a = tokenizeWords(before);
    const b = tokenizeWords(after);
    const counts = new Map<string, number>();
    for (const w of a) counts.set(w, (counts.get(w) ?? 0) + 1);
    let shared = 0;
    for (const w of b) {
      const n = counts.get(w) ?? 0;
      if (n > 0) { shared += 1; counts.set(w, n - 1); }
    }
    const max = Math.max(a.length, b.length);
    return {
      wordsBefore: a.length,
      wordsAfter: b.length,
      changedWords: max - shared,
      unchangedRatio: max === 0 ? 1 : shared / max,
    };
  >>>

fn name=buildNaturalizePrompt params="text:string" returns="string" export=true
  doc "The rewrite brief: naturalize tone and rhythm, preserve meaning and facts, output ONLY the rewritten text (no commentary, no code fences unless the input is code)."
  handler <<<
    return [
      'Rewrite the text below so it reads as natural, human-written prose while preserving every fact, claim, name, number, and the overall structure (headings, lists, paragraph breaks).',
      '',
      'Goals:',
      '- Vary sentence length and rhythm (mix short and long sentences).',
      '- Replace formulaic AI phrasing ("delve", "furthermore", "moreover", "in conclusion", "it is important to note") with direct, specific language.',
      '- Keep the same voice and register; do not add opinions, facts, or examples that are not in the original.',
      '- Do not summarize, shorten drastically, or expand — stay within roughly ±20% of the original length.',
      '',
      'Output ONLY the rewritten text. No preamble, no commentary, no markdown fences (unless the input itself is fenced code).',
      '',
      '---',
      text,
      '---',
    ].join('\n');
  >>>

fn name=stripDispatchWrapper params="raw:string" returns="string"
  doc "Remove common dispatch wrappers (a single surrounding code fence, leading 'Here is...' preamble lines) so a chatty engine cannot smuggle commentary into the output."
  handler <<<
    let text = raw.trim();
    const fence = text.match(/^```[a-zA-Z]*\n([\s\S]*?)\n?```\s*$/);
    if (fence) text = fence[1].trim();
    return text;
  >>>

fn name=runNaturalize async=true params="opts:NaturalizeOptions" returns="Promise<NaturalizeResult>" export=true
  doc "Full pipeline: deterministic clean → single-engine rewrite (engine must differ from opts.author when given) → re-scan → optional fallback clean → word-diff stats. Never throws for engine failure — returns ok:false with error."
  handler <<<
    const first = cleanText(opts.input);
    const initialFindings = first.report.findings.length;
    const stats = { wordsBefore: 0, wordsAfter: 0, changedWords: 0, unchangedRatio: 1 };
    const base: NaturalizeResult = {
      ok: false,
      engineId: opts.engineId,
      output: '',
      initialFindings,
      rewriteCleaned: false,
      finalClean: false,
      ...stats,
      residualNotAssessable: first.report.notAssessable,
      error: undefined,
    };

    if (opts.author && opts.author.trim() && opts.author.trim() === opts.engineId) {
      return { ...base, error: `Rewrite engine '${opts.engineId}' is the author engine — writer and rewriter must differ (writer ≠ rewriter).` };
    }

    let engine;
    try {
      engine = opts.registry.get(opts.engineId);
    } catch (err) {
      return { ...base, error: err instanceof Error ? err.message : String(err) };
    }

    let rewritten = '';
    try {
      const result = await opts.adapter.dispatch({
        engine,
        prompt: buildNaturalizePrompt(first.output),
        systemPrompt: 'You are a text naturalizer. Rewrite the provided text into natural human prose while preserving meaning, facts, and structure. Output ONLY the rewritten text — no commentary, no tools, no file reads, no commands.',
        textOnly: true,
        cwd: opts.cwd,
        mode: 'exec',
        timeout: opts.timeout,
        outputDir: opts.outputDir,
      });
      if (result.exitCode !== 0 || result.timedOut) {
        const detail = result.timedOut ? 'timed out' : (result.stderr?.trim()?.slice(0, 200) || `exit ${result.exitCode}`);
        return { ...base, error: `rewrite dispatch failed: ${detail}` };
      }
      rewritten = stripDispatchWrapper(String(result.stdout ?? ''));
    } catch (err) {
      return { ...base, error: `rewrite dispatch threw: ${err instanceof Error ? err.message : String(err)}` };
    }

    if (!rewritten) {
      return { ...base, error: 'rewrite engine returned empty output' };
    }

    const rescan = scanText(rewritten);
    let output = rewritten;
    let rewriteCleaned = false;
    if (!rescan.clean) {
      output = cleanText(rewritten).output;
      rewriteCleaned = true;
    }
    const verify = scanText(output);
    if (!verify.clean) {
      return { ...base, rewriteCleaned, error: 'internal error: final output still has actionable findings — refusing to emit' };
    }

    const diff = wordDiffStats(first.output, output);
    return {
      ...base,
      ok: true,
      output,
      rewriteCleaned,
      finalClean: true,
      ...diff,
      residualNotAssessable: verify.notAssessable,
    };
  >>>
