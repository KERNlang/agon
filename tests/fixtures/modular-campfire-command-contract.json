{
  "sourceCommit": "98402af66579fb9fe05845e215f2b6ac8a082f1d",
  "sourcePath": "packages/cli/src/commands/campfire.ts",
  "sourceSha256": "f43e52e25d378f441048c503ddcd0b5d275912fe7ad244178dafc428d63d9bfb",
  "command": {
    "meta": {
      "name": "campfire",
      "description": "Open discussion — all engines think together, no competition"
    },
    "args": {
      "topic": {
        "type": "positional",
        "description": "Topic to discuss",
        "required": true
      },
      "engines": {
        "type": "string",
        "alias": "e",
        "description": "Comma-separated engine list"
      },
      "strategy": {
        "type": "string",
        "alias": "s",
        "description": "Strategy: lead-first or all-respond",
        "default": "lead-first"
      },
      "lead": {
        "type": "string",
        "alias": "l",
        "description": "Lead engine ID (for lead-first strategy)"
      },
      "timeout": {
        "type": "string",
        "description": "Timeout in seconds",
        "default": "120"
      },
      "label": {
        "type": "string",
        "description": "Human-readable suffix baked into the run dir name."
      },
      "quiet": {
        "type": "boolean",
        "description": "Suppress streaming output; stdout becomes only the run dir path + final summary."
      }
    }
  }
}
